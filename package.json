{
  "name": "hareware",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "postinstall": "wrangler types",
    "prebuild": "wrangler types",
    "build": "astro check && astro build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply hareware --remote",
    "reminders:send": "vitest run --config vitest.live.config.ts --reporter=verbose --disable-console-intercept",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.2.6",
    "@astrojs/react": "^6.0.1",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@formkit/auto-animate": "^0.9.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "astro": "^7.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "downloadjs": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.9.3",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.39.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/downloadjs": "^1.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.128.0"
  }
