---
import { EditorialNav } from "~/components/editorial-nav";
import { NavGroup } from "~/components/nav-group";
import { editorialNav, toolsNav } from "~/lib/nav";
import type { Session } from "~/lib/session";

type Props = { session: Session | null; pathname: string; cached: boolean };
const { session, pathname, cached } = Astro.props;
---

{
  /* static markup: no client: directive on NavGroup, so this whole sidebar
    ships as html and the public tools keep costing no javascript */
}
<aside
  class="bg-sidebar text-sidebar-foreground border-sidebar-border hidden h-full w-(--sidebar-width) shrink-0 flex-col border-r transition-[width] duration-200 group-data-[state=collapsed]/shell:w-(--sidebar-width-icon) md:flex"
>
  <div class="flex h-12 shrink-0 items-center gap-2 px-3">
    <img
      src="/favicon.svg"
      alt=""
      width="20"
      height="20"
      class="shrink-0 dark:invert"
    />
    <span
      class="truncate text-sm font-semibold group-data-[state=collapsed]/shell:hidden"
    >
      HareWare
    </span>
  </div>

  <nav class="flex flex-1 flex-col gap-2 overflow-y-auto p-3 pt-1">
    {
      /* a private page knows the answer already and renders it here; a cached
         one leaves it to the island so its html stays anonymous */
      cached ? (
        <EditorialNav client:idle />
      ) : (
        session && (
          <>
            <NavGroup
              items={editorialNav}
              pathname={pathname}
              label="Editorial"
            />
            <hr class="border-sidebar-border my-2" />
          </>
        )
      )
    }

    <NavGroup items={toolsNav} pathname={pathname} label="Tools" />
  </nav>

  <div class="border-sidebar-border flex h-10 items-center border-t px-3">
    <a
      href="https://github.com/zsrobinson/hareware"
      target="_blank"
      rel="noreferrer"
      title="HareWare on GitHub"
      class="text-sidebar-foreground/50 hover:text-sidebar-foreground inline-flex size-6 items-center justify-center rounded-md transition-colors"
    >
      {/* lucide dropped its brand marks, so this one is inline */}
      <svg
        viewBox="0 0 16 16"
        aria-hidden="true"
        class="size-4"
        fill="currentColor"
      >
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
      <span class="sr-only">HareWare on GitHub</span>
    </a>
  </div>
</aside>
