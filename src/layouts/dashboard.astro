---
import { ClientRouter } from "astro:transitions";
import { PanelLeftIcon } from "lucide-react";
import AppSidebar from "~/components/app-sidebar.astro";
import NavProgress from "~/components/nav-progress.astro";
import { SidebarSheet } from "~/components/sidebar-sheet";
import type { ViewerState } from "~/lib/admin";
import { assertAnonymous } from "~/lib/anonymous";
import "~/styles/globals.css";
import "~/styles/fonts.css";

type Props = {
  title: string;
  /*
    who is looking, for a page the cdn does not cache. one prop rather than
    two: a page that passed `session` and forgot `profile` rendered a raw
    discord id where a name belongs.

    a page that sets `s-maxage` passes nothing at all: its html goes to
    everyone, so the account panel asks /api/session.json for itself instead.
    that panel is the only thing left that varies by who is looking, because
    the nav no longer does
  */
  viewer?: ViewerState | null;
};

const { title, viewer } = Astro.props;

/*
  the invariant the sidebar rests on, checked every request rather than only in
  dev — see ~/lib/anonymous, where it is a pure function with tests
*/
assertAnonymous({
  pathname: Astro.url.pathname,
  headers: Astro.response.headers,
  viewer: viewer ?? null,
  dev: import.meta.env.DEV,
});

/* shadcn's own cookie name and meaning: "true" is open. reading it server-side
   means data-state is already right in the first paint, so the sidebar never
   snaps from one width to the other.

   a prerendered page is built long before there is a request to read it from —
   asking anyway is what made astro warn about `Astro.request.headers` on
   /custom. the script at the bottom reconciles those on the client instead */
const collapsed = Astro.isPrerendered
  ? false
  : Astro.cookies.get("sidebar_state")?.value === "false";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/bot-logo.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>HareWare: {title}</title>
    <ClientRouter />

    {
      /* pages that need something of their own in the head — the slide fonts,
        so far — put it here rather than the shell knowing about them */
    }
    <slot name="head" />
  </head>

  <body class="font-sans">
    <NavProgress />

    <div
      id="shell"
      class="group/shell flex h-svh w-full overflow-hidden"
      data-state={collapsed ? "collapsed" : "expanded"}
      style="--sidebar-width: 15rem; --sidebar-width-icon: 3.25rem"
    >
      <AppSidebar
        viewer={viewer}
        pathname={Astro.url.pathname}
        returnTo={`${Astro.url.pathname}${Astro.url.search}`}
      />

      <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
        {
          /* opaque, and outside the scroll container: the slide previews used
            to show through this on the way past */
        }
        <header
          class="bg-background relative z-20 flex h-12 shrink-0 items-center gap-1 border-b px-3"
        >
          {
            /*
              On a phone the sidebar is behind a tap, so the bar carries the
              brand: HareWare / Invocation Log, where the page half opens the
              menu. Static markup, so it is there in the first paint rather
              than after the island hydrates. Below 400px the name gives way
              and the mark stays, since the mark is what matches the browser
              tab and the bot's avatar in Discord.
            */
          }
          <a
            href="/"
            class="hover:bg-accent -ml-1 flex shrink-0 items-center gap-1.5 rounded-md p-1 transition-colors md:hidden"
            aria-label="HareWare, home"
          >
            <img
              src="/bot-logo.svg"
              alt=""
              width="24"
              height="24"
              class="size-6 shrink-0 rounded"
            />
            <span class="hidden text-sm font-semibold min-[400px]:inline"
              >HareWare</span
            >
          </a>

          <span class="text-foreground/25 shrink-0 md:hidden" aria-hidden="true"
            >/</span
          >

          <SidebarSheet
            client:media="(max-width: 767px)"
            pathname={Astro.url.pathname}
            returnTo={`${Astro.url.pathname}${Astro.url.search}`}
            title={title}
            viewer={viewer}
          />

          <button
            id="sidebar-toggle"
            type="button"
            aria-label="Toggle sidebar"
            aria-controls="shell"
            class="text-foreground/70 hover:bg-accent hover:text-foreground hidden size-8 items-center justify-center rounded-md transition-colors md:inline-flex"
          >
            <PanelLeftIcon className="size-4" />
          </button>

          {
            /* below `md` the sheet trigger is already wearing this, so a
               second copy of it would only take the room */
          }
          <h1 class="hidden truncate px-1 text-sm font-medium md:block">
            {title}
          </h1>

          {/* #24 fills this with the sync indicator; empty until then */}
          <div class="ml-auto flex items-center gap-2">
            <slot name="sync" />
          </div>
        </header>

        <main id="content" class="min-w-0 flex-1 overflow-y-auto p-4 md:p-6">
          <slot />
        </main>
      </div>
    </div>

    <script>
      /* the listener lives on document so it survives ClientRouter's swaps,
         and the flag keeps a re-executed module from binding it twice */
      const KEY = "__hwSidebarToggle";

      /* /custom is prerendered, so its html is built long before there is a
         cookie to read and always says expanded. reconciling here keeps the
         width from snapping back when you navigate onto it */
      function sync() {
        const shell = document.getElementById("shell");
        if (!shell) return;

        const open = !/(?:^|;\s*)sidebar_state=false(?:;|$)/.test(
          document.cookie,
        );
        shell.dataset.state = open ? "expanded" : "collapsed";
      }

      sync();
      document.addEventListener("astro:page-load", sync);

      if (!(KEY in window)) {
        Object.assign(window, { [KEY]: true });

        document.addEventListener("click", (event) => {
          const target = event.target as HTMLElement | null;
          if (!target?.closest("#sidebar-toggle")) return;

          const shell = document.getElementById("shell");
          if (!shell) return;

          const open = shell.dataset.state !== "collapsed";
          shell.dataset.state = open ? "collapsed" : "expanded";

          /* the server reads this back on the next navigation, so the width
             survives a full page load rather than only a client-side one */
          document.cookie = `sidebar_state=${!open}; path=/; max-age=${
            60 * 60 * 24 * 7
          }; samesite=lax`;
        });
      }
    </script>
  </body>
</html>
