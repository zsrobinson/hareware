---
import { ClientRouter } from "astro:transitions";
import { PanelLeftIcon } from "lucide-react";
import AppSidebar from "~/components/app-sidebar.astro";
import NavProgress from "~/components/nav-progress.astro";
import { SidebarSheet } from "~/components/sidebar-sheet";
import { Toaster } from "~/components/ui/sonner";
import type { ViewerState } from "~/lib/admin";
import { assertAnonymous } from "~/lib/anonymous";
import "~/styles/globals.css";
import "~/styles/fonts.css";

type Props = {
  title: string;
  /** who is looking, on a page the cdn does not cache. A cached page passes
      nothing and the account panel asks /api/session.json; see AGENTS.md */
  viewer?: ViewerState | null;
  /** how wide the content may get */
  width?: keyof typeof WIDTHS;
};

const WIDTHS = {
  form: "max-w-120",
  prose: "max-w-3xl",
  wide: "max-w-5xl",
  full: "max-w-none",
} as const;

const { title, viewer, width = "wide" } = Astro.props;

/* checked on every request, not only in dev; see ~/lib/anonymous */
assertAnonymous({
  pathname: Astro.url.pathname,
  headers: Astro.response.headers,
  viewer: viewer ?? null,
  dev: import.meta.env.DEV,
});

/* shadcn's cookie, read server-side so the first paint has the right width.
   A prerendered page has no request to read; the script below fixes it up */
const collapsed = Astro.isPrerendered
  ? false
  : Astro.cookies.get("sidebar_state")?.value === "false";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/bot-logo.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>HareWare: {title}</title>
    <ClientRouter />

    {/* a page's own additions to the head */}
    <slot name="head" />
  </head>

  <body class="font-sans">
    <NavProgress />

    <div
      id="shell"
      class="group/shell flex h-svh w-full overflow-hidden"
      data-state={collapsed ? "collapsed" : "expanded"}
      style="--sidebar-width: 15rem; --sidebar-width-icon: 3.25rem"
    >
      <AppSidebar
        viewer={viewer}
        pathname={Astro.url.pathname}
        returnTo={`${Astro.url.pathname}${Astro.url.search}`}
      />

      <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
        {
          /* opaque and outside the scroll container, so content cannot show through */
        }
        <header
          class="bg-background relative z-20 flex h-12 shrink-0 items-center gap-1 border-b px-3"
        >
          {
            /* on a phone the bar carries the brand; below 400px only the mark */
          }
          <a
            href="/"
            class="hover:bg-accent -ml-1 flex shrink-0 items-center gap-1.5 rounded-md p-1 transition-colors md:hidden"
            aria-label="HareWare, home"
          >
            <img
              src="/bot-logo.svg"
              alt=""
              width="24"
              height="24"
              class="size-6 shrink-0 rounded"
            />
            <span class="hidden text-sm font-semibold min-[400px]:inline"
              >HareWare</span
            >
          </a>

          <span class="text-foreground/25 shrink-0 md:hidden" aria-hidden="true"
            >/</span
          >

          <SidebarSheet
            client:media="(max-width: 767px)"
            pathname={Astro.url.pathname}
            returnTo={`${Astro.url.pathname}${Astro.url.search}`}
            title={title}
            viewer={viewer}
          />

          <button
            id="sidebar-toggle"
            type="button"
            aria-label="Toggle sidebar"
            aria-controls="shell"
            class="text-foreground/70 hover:bg-accent hover:text-foreground hidden size-8 items-center justify-center rounded-md transition-colors md:inline-flex"
          >
            <PanelLeftIcon className="size-4" />
          </button>

          {/* below `md` the sheet trigger shows the title */}
          <h1 class="hidden truncate px-1 text-sm font-medium md:block">
            {title}
          </h1>

          <div class="ml-auto flex items-center gap-2">
            <slot name="sync" />
          </div>
        </header>

        <main id="content" class="min-w-0 flex-1 overflow-y-auto p-4 md:p-6">
          <div class:list={["mx-auto w-full", WIDTHS[width]]}>
            <slot />
          </div>
        </main>
      </div>
    </div>

    {
      /* `client:load`: sonner keeps no backlog, so a toast fired before this
        hydrates is lost */
    }
    <Toaster client:load />

    <script>
      /* on document to survive ClientRouter's swaps; the flag stops a
         re-executed module binding it twice */
      const KEY = "__hwSidebarToggle";

      /* prerendered pages always say expanded until this reads the cookie */
      function sync() {
        const shell = document.getElementById("shell");
        if (!shell) return;

        const open = !/(?:^|;\s*)sidebar_state=false(?:;|$)/.test(
          document.cookie,
        );
        shell.dataset.state = open ? "expanded" : "collapsed";
      }

      sync();
      document.addEventListener("astro:page-load", sync);

      if (!(KEY in window)) {
        Object.assign(window, { [KEY]: true });

        document.addEventListener("click", (event) => {
          const target = event.target as HTMLElement | null;
          if (!target?.closest("#sidebar-toggle")) return;

          const shell = document.getElementById("shell");
          if (!shell) return;

          const open = shell.dataset.state !== "collapsed";
          shell.dataset.state = open ? "collapsed" : "expanded";

          /* read back by the server on the next full load */
          document.cookie = `sidebar_state=${!open}; path=/; max-age=${
            60 * 60 * 24 * 7
          }; samesite=lax`;
        });
      }
    </script>
  </body>
</html>
