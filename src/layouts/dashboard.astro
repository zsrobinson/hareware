---
import { ClientRouter } from "astro:transitions";
import { PanelLeftIcon } from "lucide-react";
import AppSidebar from "~/components/app-sidebar.astro";
import NavProgress from "~/components/nav-progress.astro";
import { SidebarSheet } from "~/components/sidebar-sheet";
import type { Session } from "~/lib/session";
import "~/styles/globals.css";
import "~/styles/fonts.css";

type Props = {
  title: string;
  /* the answer from getSession(), for a page the cdn does not cache */
  session?: Session | null;
  /* set on a page that sets `s-maxage`: its html is served to everyone, so the
     nav that varies by who you are has to be revealed client-side instead */
  cached?: boolean;
};

const { title, session = null, cached = false } = Astro.props;

/*
  the invariant the sidebar rests on: a response that renders who you are must
  never be one a shared cache can hand to somebody else. adding an `s-maxage`
  to a page that passes `session` would put one member's name in every other
  member's sidebar, and it would show up as a support question months later
  rather than as a failure here. so fail here
*/
if (import.meta.env.DEV && session) {
  const cacheControl = Astro.response.headers.get("cache-control") ?? "";

  if (/public|s-maxage/.test(cacheControl)) {
    throw new Error(
      `${Astro.url.pathname} renders a session but sets "cache-control: ${cacheControl}". ` +
        "Either drop `session` and pass `cached` so the nav is revealed client-side, " +
        "or make the response private.",
    );
  }
}

/* shadcn's own cookie name and meaning: "true" is open. reading it server-side
   means data-state is already right in the first paint, so the sidebar never
   snaps from one width to the other.

   a prerendered page is built long before there is a request to read it from —
   asking anyway is what made astro warn about `Astro.request.headers` on
   /custom. the script at the bottom reconciles those on the client instead */
const collapsed = Astro.isPrerendered
  ? false
  : Astro.cookies.get("sidebar_state")?.value === "false";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>HareWare: {title}</title>
    <ClientRouter />

    {
      /* pages that need something of their own in the head — the slide fonts,
        so far — put it here rather than the shell knowing about them */
    }
    <slot name="head" />
  </head>

  <body class="font-sans">
    <NavProgress />

    <div
      id="shell"
      class="group/shell flex h-svh w-full overflow-hidden"
      data-state={collapsed ? "collapsed" : "expanded"}
      style="--sidebar-width: 15rem; --sidebar-width-icon: 3.25rem"
    >
      <AppSidebar
        session={session}
        cached={cached}
        pathname={Astro.url.pathname}
      />

      <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
        {
          /* opaque, and outside the scroll container: the slide previews used
            to show through this on the way past */
        }
        <header
          class="bg-background relative z-20 flex h-12 shrink-0 items-center gap-1 border-b px-3"
        >
          <SidebarSheet
            client:media="(max-width: 767px)"
            pathname={Astro.url.pathname}
            signedIn={session !== null}
          />

          <button
            id="sidebar-toggle"
            type="button"
            aria-label="Toggle sidebar"
            aria-controls="shell"
            class="text-foreground/70 hover:bg-accent hover:text-foreground hidden size-8 items-center justify-center rounded-md transition-colors md:inline-flex"
          >
            <PanelLeftIcon className="size-4" />
          </button>

          <h1 class="truncate px-1 text-sm font-medium">{title}</h1>

          {/* #24 fills this with the sync indicator; empty until then */}
          <div class="ml-auto flex items-center gap-2">
            <slot name="sync" />
          </div>
        </header>

        <main id="content" class="min-w-0 flex-1 overflow-y-auto p-4 md:p-6">
          <slot />
        </main>
      </div>
    </div>

    <script>
      /* the listener lives on document so it survives ClientRouter's swaps,
         and the flag keeps a re-executed module from binding it twice */
      const KEY = "__hwSidebarToggle";

      /* /custom is prerendered, so its html is built long before there is a
         cookie to read and always says expanded. reconciling here keeps the
         width from snapping back when you navigate onto it */
      function sync() {
        const shell = document.getElementById("shell");
        if (!shell) return;

        const open = !/(?:^|;\s*)sidebar_state=false(?:;|$)/.test(
          document.cookie,
        );
        shell.dataset.state = open ? "expanded" : "collapsed";
      }

      sync();
      document.addEventListener("astro:page-load", sync);

      if (!(KEY in window)) {
        Object.assign(window, { [KEY]: true });

        document.addEventListener("click", (event) => {
          const target = event.target as HTMLElement | null;
          if (!target?.closest("#sidebar-toggle")) return;

          const shell = document.getElementById("shell");
          if (!shell) return;

          const open = shell.dataset.state !== "collapsed";
          shell.dataset.state = open ? "collapsed" : "expanded";

          /* the server reads this back on the next navigation, so the width
             survives a full page load rather than only a client-side one */
          document.cookie = `sidebar_state=${!open}; path=/; max-age=${
            60 * 60 * 24 * 7
          }; samesite=lax`;
        });
      }
    </script>
  </body>
</html>
