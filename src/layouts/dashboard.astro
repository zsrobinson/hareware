---
import { ClientRouter } from "astro:transitions";
import AppSidebar from "~/components/app-sidebar.astro";
import NavProgress from "~/components/nav-progress.astro";
import { SidebarSheet } from "~/components/sidebar-sheet";
import { pagePath } from "~/lib/nav";
import { Toaster } from "~/components/ui/sonner";
import "~/styles/globals.css";
import "~/styles/fonts.css";

type Props = {
  title: string;
  /** how wide the content may get */
  width?: keyof typeof WIDTHS;
  /** false where the page is a message that names itself (404, sign-in) */
  heading?: boolean;
};

const WIDTHS = {
  form: "max-w-2xl",
  prose: "max-w-3xl",
  wide: "max-w-5xl",
  full: "max-w-none",
} as const;

const { title, width = "wide", heading = true } = Astro.props;
const pathname = pagePath(Astro.url.pathname);

/* every page is prerendered (ADR 0012), so the sidebar is drawn open and the
   script below applies shadcn's sidebar_state cookie */
const collapsed = false;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/bot-logo.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>HareWare: {title}</title>
    <ClientRouter />

    {/* a page's own additions to the head */}
    <slot name="head" />
  </head>

  <body class="font-sans">
    {/* first to take focus, so a keyboard skips the sidebar's links */}
    <a
      href="#content"
      class="bg-background focus-visible:ring-ring/50 sr-only rounded-lg border text-sm font-medium shadow-sm outline-none focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-1.5 focus-visible:ring-3"
      >Skip to content</a
    >
    <NavProgress />

    {
      /* on a laptop the shell is the screen and never scrolls: <main> does,
        and the side panel beside it on its own. So the sidebar and the panel
        stay put, and a menu or sheet that locks the document's scroll moves
        nothing. It and <main> are positioned so an sr-only status or anything
        else absolute is placed inside them; left to the document, one far
        down the page made the document a second scroller.

        On a phone the document scrolls instead, under a bar that sticks to
        the top, so the browser can fold its address bar away and a tap on the
        status bar goes back up. No box around the bar may scroll or hide its
        overflow, or the bar sticks to that box rather than to the screen;
        clip keeps a wide child from scrolling the page sideways without
        being either */
    }
    <div
      id="shell"
      class="group/shell relative flex w-full max-md:overflow-x-clip md:h-svh md:overflow-hidden"
      data-state={collapsed ? "collapsed" : "expanded"}
      style="--sidebar-width: 15rem; --sidebar-width-icon: 3.25rem"
    >
      <AppSidebar
        pathname={pathname}
        returnTo={`${pathname}${Astro.url.search}`}
      />

      <div class="flex min-w-0 flex-1 flex-col md:overflow-hidden">
        {
          /* a phone has no sidebar, so a bar carries the brand and the menu.
            The page scrolls under it, so it sits over what the page raises
            (a slide being drawn is z-20) and under the sheets */
        }
        <header
          id="top-bar"
          class="bg-background sticky top-0 z-30 flex h-12 shrink-0 items-center gap-2 border-b px-3 md:hidden"
        >
          <a
            href="/"
            class="hover:bg-accent -ml-1 flex shrink-0 rounded-md p-1 transition-colors"
            aria-label="HareWare, home"
          >
            <img
              src="/bot-logo.svg"
              alt=""
              width="24"
              height="24"
              class="size-6 shrink-0 rounded"
            />
          </a>
          <span class="truncate text-sm font-semibold" aria-hidden="true"
            >{title}</span
          >
          <SidebarSheet
            client:media="(max-width: 767px)"
            pathname={pathname}
            returnTo={`${pathname}${Astro.url.search}`}
          />
        </header>

        {
          /* a side panel (Customize, a person) opens beside the content and
            narrows it rather than covering it; islands portal into it */
        }
        <div class="flex min-h-0 flex-1">
          {
            /* a laptop's one scroller (~/lib/page-scroll). The gutter is kept
              when nothing overflows, so where scrollbars always show
              (Windows) a page does not shift sideways as it loads or grows.
              On a phone the skip link brings it out from under the bar */
          }
          <main
            id="content"
            tabindex="-1"
            class="relative min-w-0 flex-1 p-4 outline-none max-md:scroll-mt-12 md:[scrollbar-gutter:stable] md:overflow-y-auto md:px-10 md:py-7"
          >
            {
              /* every page starts from the same left edge, however wide it runs */
            }
            <div class:list={["w-full", WIDTHS[width]]}>
              {
                /* on a phone the row folds away when it holds only the
                   hidden h1 and actions a phone hides */
                heading && (
                  <div class="mb-6 flex min-h-8 flex-wrap items-center gap-x-3 gap-y-2 max-md:mb-4 max-md:min-h-0 max-md:not-has-[#page-actions>:not(.max-md\:hidden)]:mb-0">
                    {/* the bar above names the page on a phone */}
                    <h1 class="text-2xl font-semibold tracking-tight max-md:sr-only">
                      {title}
                    </h1>
                    {/* Reload, Download CSV: what acts on the whole page */}
                    <div
                      id="page-actions"
                      class="flex flex-wrap items-center gap-2 empty:hidden md:ml-auto"
                    >
                      <slot name="actions" />
                    </div>
                  </div>
                )
              }
              <slot />
            </div>
          </main>
          <div id="side-panel" class="contents"></div>
        </div>
      </div>
    </div>

    {
      /* `client:load`: sonner keeps no backlog, so a toast fired before this
        hydrates is lost */
    }
    <Toaster client:load />

    <script>
      /* on document to survive ClientRouter's swaps; the flag stops a
         re-executed module binding it twice */
      const KEY = "__hwSidebarToggle";

      /* prerendered pages always say expanded until this reads the cookie */
      function sync() {
        const shell = document.getElementById("shell");
        if (!shell) return;

        const open = !/(?:^|;\s*)sidebar_state=false(?:;|$)/.test(
          document.cookie,
        );
        shell.dataset.state = open ? "expanded" : "collapsed";
      }

      sync();
      document.addEventListener("astro:page-load", sync);

      if (!(KEY in window)) {
        Object.assign(window, { [KEY]: true });

        document.addEventListener("click", (event) => {
          const target = event.target as HTMLElement | null;
          if (!target?.closest("#sidebar-toggle")) return;

          const shell = document.getElementById("shell");
          if (!shell) return;

          const open = shell.dataset.state !== "collapsed";
          shell.dataset.state = open ? "collapsed" : "expanded";

          /* read back by the server on the next full load */
          document.cookie = `sidebar_state=${!open}; path=/; max-age=${
            60 * 60 * 24 * 7
          }; samesite=lax`;
        });
      }
    </script>
  </body>
</html>
