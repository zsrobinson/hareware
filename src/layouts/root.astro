---
import { ClientRouter } from "astro:transitions";
import "~/styles/globals.css";
import "~/styles/fonts.css";

type Props = { title?: string; preloadSlideFonts?: boolean };
const title = Astro.props.title || "Instagram Post Creator";

/* the two faces a slide paints with. only the pages that draw slides ask for
   these — everywhere else they would be 162 KB nobody looks at */
const slideFonts = [
  "/SourceSerif4Display-Semibold.ttf.woff2",
  "/SourceSerif4-Regular.ttf.woff2",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hareware: {title}</title>
    {
      Astro.props.preloadSlideFonts &&
        slideFonts.map((href) => (
          <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={href}
            crossorigin
          />
        ))
    }
    <ClientRouter />
  </head>

  <body class="m-4 mb-16 md:m-8 md:mb-24">
    <!-- client-side navigation replaces the browser's own loading indicator, so
      this stands in for it. transition:persist keeps the live node through the
      swap — a fresh copy from the incoming page would cut the finish short -->
    <div id="nav-progress" transition:persist="nav-progress" aria-hidden="true">
    </div>

    <nav>
      <div class="flex flex-wrap items-end gap-4">
        <a href="/" tabindex="-1">
          <img
            src="/hareware-banner.png"
            alt="Hareware Banner"
            class="h-16 dark:grayscale dark:invert"
          />
        </a>

        <div class="flex flex-col gap-1">
          <a href="/">
            <h1 class="text-2xl leading-none font-bold">
              {title}
            </h1>
          </a>

          <div class="text-sm leading-none font-medium">
            by Zachary Robinson · View on&nbsp;<a
              href="https://github.com/zsrobinson/hareware"
              class="text-sm leading-none underline"
              target="_blank"
            >
              GitHub
            </a>
          </div>
        </div>
      </div>

      <hr class="my-6" />
    </nav>

    <slot />

    <script>
      /* astro fires neither of these on a full page load, so the bar only ever
         stands in where the browser has stopped showing its own indicator.
         listeners on document survive the swaps, so registering once is enough */
      const SHOW_AFTER = 150; // let quick navigations finish without a flash

      let show: ReturnType<typeof setTimeout> | undefined;
      let reset: ReturnType<typeof setTimeout> | undefined;

      const bar = () => document.getElementById("nav-progress");

      function start() {
        const el = bar();
        if (!el) return;

        clearTimeout(show);
        clearTimeout(reset);

        // a navigation started while one was already running: leave the bar
        // where it is and let it keep creeping, rather than snapping it back
        // to nothing and starting over, which reads as a flicker
        if (el.getAttribute("data-state") === "loading") return;

        el.removeAttribute("data-state"); // back to zero width, untransitioned

        show = setTimeout(
          () => el.setAttribute("data-state", "loading"),
          SHOW_AFTER,
        );
      }

      function finish() {
        const el = bar();
        if (!el) return;

        clearTimeout(show);
        const state = el.getAttribute("data-state");

        // page-load lands a moment after preparation finished, so without this
        // the second call would strip the bar mid-wind-down
        if (state === "done") return;

        // it never became visible, so there is nothing to wind down
        if (state !== "loading") {
          el.removeAttribute("data-state");
          return;
        }

        el.setAttribute("data-state", "done");
        reset = setTimeout(() => el.removeAttribute("data-state"), 400);
      }

      document.addEventListener("astro:before-preparation", start);
      document.addEventListener("astro:after-preparation", finish);
      document.addEventListener("astro:page-load", finish); // in case it didn't
    </script>
  </body>
</html>
