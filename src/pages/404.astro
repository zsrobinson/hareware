---
/*
  a url that is nothing at all — which, now that the admin tools refuse in
  person, is the only thing a 404 here means.

  no viewer is resolved: this renders for anybody, including a crawler, and
  asking discord who they are on the way to saying "no such page" would be a
  request per stray link. the account panel fills itself in client-side
*/
import Dashboard from "~/layouts/dashboard.astro";
import Message from "~/components/message.astro";
---

<Dashboard title="Not found">
  <Message
    title="Page not found"
    action={{ label: "Back to the tools", href: "/generate" }}
  >
    That address is not one of HareWare's tools. The sidebar lists them all.
  </Message>
</Dashboard>
