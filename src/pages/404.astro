---
/*
  a url that is nothing at all — which, now that the admin tools refuse in
  person, is the only thing a 404 here means.

  no viewer is resolved: this renders for anybody, including a crawler, and
  asking discord who they are on the way to saying "no such page" would be a
  request per stray link. the account panel fills itself in client-side
*/
import Dashboard from "~/layouts/dashboard.astro";
import { buttonVariants } from "~/components/ui/button";
---

<Dashboard title="Not found">
  <section class="mx-auto max-w-lg py-12">
    <p class="text-hare mb-2 text-xs font-semibold tracking-[0.18em] uppercase">
      404
    </p>
    <h2 class="font-display text-3xl leading-tight">There is nothing here</h2>
    <p class="text-muted-foreground mt-3 text-sm leading-6">
      That address does not match any of HareWare's tools. If a link in the
      Discord sent you here, the tool it pointed at has probably moved or been
      retired — the sidebar lists everything there is.
    </p>

    <a href="/generate" class={`${buttonVariants({ size: "lg" })} mt-6`}>
      Back to the tools
    </a>
  </section>
</Dashboard>
