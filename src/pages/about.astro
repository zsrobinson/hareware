---
import { ExternalLinkIcon } from "lucide-react";
import { Link } from "~/components/ui/link";
import Dashboard from "~/layouts/dashboard.astro";

/* nothing here is per-request, so it is built once and served from assets */
export const prerender = true;
---

<Dashboard title="About" cached>
  <div class="flex max-w-prose flex-col gap-4">
    <h2 class="text-xl font-semibold">HareWare</h2>

    <p class="text-muted-foreground leading-relaxed">
      The in-house tooling for <a
        href="https://theumdhare.com"
        target="_blank"
        rel="noreferrer"
        class="text-foreground underline">The Hare</a
      >: the editorial board's article tracker, and a set of tools that turn
      published articles into Instagram posts, InDesign copy and newsletter
      content.
    </p>

    <p class="text-muted-foreground leading-relaxed">
      Everything under Tools is open to anyone. The article board needs a club
      Discord account.
    </p>

    <div>
      <Link
        variant="secondary"
        href="https://github.com/zsrobinson/hareware"
        target="_blank"
        rel="noreferrer"
      >
        View source on GitHub
        <ExternalLinkIcon />
      </Link>
    </div>
  </div>
</Dashboard>
