---
/*
  What an admin tool renders when whoever asked may not see it. The guard
  rewrites here and leaves the reason in `locals.admission`, so this page never
  works the answer out for itself: a direct visit goes to a guarded route
  instead, and comes back with a real admission.
*/
import Dashboard from "~/layouts/dashboard.astro";
import AccessDenied from "~/components/access-denied.astro";
import { viewerState } from "~/lib/admin";

const admission = Astro.locals.admission;

if (!admission || admission.access.allowed) {
  return Astro.redirect("/automations");
}

const { access, returnTo } = admission;

/* Names the member back to them, so no cache may hold it. The guard sets the
   status; this page only renders the body. */
Astro.response.headers.set("cache-control", "private, no-store");
---

<Dashboard title="No access" viewer={viewerState(access.who)}>
  <AccessDenied
    denial={access.denial}
    profile={access.who?.profile ?? null}
    returnTo={returnTo}
  />
</Dashboard>
