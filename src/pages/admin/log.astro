---
import { env } from "cloudflare:workers";
import Dashboard from "~/layouts/dashboard.astro";
import { InvocationLog } from "~/components/invocation-log";
import { notFound, viewer } from "~/lib/admin";
import { PAYLOAD_DAYS, recent } from "~/lib/log";

/* one lookup answers both whether they may be here and what to call them, so
   the sidebar costs no second request to discord */
const who = await viewer(Astro.request);
if (!who?.admin) return notFound();

/* the log names real members behind pseudonymous bylines, so no cache may hold
   any part of this — ADR 0005 for the rule, ADR 0007 for why this page is the
   sensitive one */
Astro.response.headers.set("cache-control", "private, no-store");

const rows = env.DB ? await recent(env.DB, 500) : [];
---

<Dashboard
  title="Invocation Log"
  session={who.session}
  profile={who.profile}
  admin
>
  <div class="space-y-4">
    <p class="text-muted-foreground text-sm">
      Everything HareWare has done. A quiet morning shows a row saying nothing
      published, which is how it is told apart from a broken one. Details are
      kept for {PAYLOAD_DAYS} days; the summaries stay.
    </p>

    <InvocationLog rows={rows} client:load />
  </div>
</Dashboard>
