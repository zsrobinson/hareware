---
import Dashboard from "~/layouts/dashboard.astro";
import { getSessionSecret } from "~/lib/auth-config";
import { getSession } from "~/lib/session";

const session = await getSession(Astro.request, getSessionSecret());

/* the board reads notion per member, so there is nothing here for a cdn to
   hold on to. #22 turns this into a redirect for anyone without the role */
Astro.response.headers.set("cache-control", "private, no-store");
---

<Dashboard title="Articles" session={session}>
  <div
    class="text-muted-foreground flex min-h-64 items-center justify-center rounded-lg border border-dashed text-sm"
  >
    The board lands in #23.
  </div>
</Dashboard>
