---
import { env } from "cloudflare:workers";
import Dashboard from "~/layouts/dashboard.astro";
import { AttendanceKiosk } from "~/components/attendance-kiosk";
import { viewerState } from "~/lib/admin";
import { admitted } from "~/lib/admin-guard";
import { easternNow } from "~/lib/eastern";
import { faces } from "~/lib/faces";
import { guildMembers } from "~/lib/member";
import {
  contributionCounts,
  defaultMeeting,
  offerableMeetings,
} from "~/lib/members/kiosk";
import {
  contributions,
  meetings,
  people,
  statusOptions,
} from "~/lib/members/roster";
import { FALLBACK_MEMBER_STATUSES } from "~/lib/members/config";

/* Reaching this page is the permission: the guard already refused anybody it
   would not admit, and its lookup knows what to call them. */
const who = admitted(Astro.locals);

/* the room can see this screen, and it lists everybody's name and email
   domain. nothing may cache any of it */
Astro.response.headers.set("cache-control", "private, no-store");

const token = env.NOTION_TOKEN;

/*
  the roster and the calendar, read once when the laptop is set down.

  the whole roster rather than a search endpoint per keystroke: fifty people
  fit in one payload, and a kiosk in a room with student wifi must keep working
  when the network does not. Every tap after this costs exactly one write.

  the articles are read only to say "3 contributions" beside a name — which is
  what tells two people sharing one apart, and per ADR 0010 that is the
  disambiguation this screen may not do without.

  the Status options come from notion's schema rather than a list in this
  repository, so renaming one is an edit in notion and nothing else
*/
const [roster, calendar, credits, notionStatuses] = token
  ? await Promise.all([
      people(token),
      meetings(token),
      contributions(token),
      statusOptions(token).catch(() => [] as string[]),
    ])
  : [[], [], [], []];

const statuses = notionStatuses.length
  ? notionStatuses
  : FALLBACK_MEMBER_STATUSES;

const counts = contributionCounts(credits);
const candidates = roster.map((person) => ({
  person,
  contributions: counts.get(person.pageId) ?? 0,
}));

const today = easternNow(new Date()).date;

/* the param wins over today's meeting so a reload mid-meeting comes back to
   the one the room is signing into */
const asked = Astro.url.searchParams.get("meeting");
const chosen = calendar.find((meeting) => meeting.pageId === asked);
const opening = chosen ?? defaultMeeting(calendar, today);

/* the past month and everything ahead, plus whatever `?meeting=` named: a
   semester of history in one select is where a mis-tap files tonight's room
   against a meeting last spring */
const offered = offerableMeetings(calendar, today, opening?.pageId ?? null);

/*
  one request for the whole guild, read twice: once for the pictures beside a
  name, and once for the Discord chip's autocomplete. A member the kiosk cannot
  draw falls back to their initials, which is also what a missing token gets
*/
const guild = await guildMembers();
const rosterFaces = await faces(
  roster.map((person) => person.discordId),
  async () => guild,
);
const guildOptions = [...guild].map(([id, profile]) => ({
  id,
  username: profile.username,
  displayName: profile.displayName,
}));
---

<Dashboard title="Attendance" viewer={viewerState(who)}>
  {
    token ? (
      <AttendanceKiosk
        meetings={offered}
        candidates={candidates}
        initialMeetingId={opening?.pageId ?? null}
        faces={rosterFaces}
        guild={guildOptions}
        statuses={statuses}
        client:load
      />
    ) : (
      <p class="text-destructive text-sm">
        NOTION_TOKEN is not set, so attendance cannot be recorded.
      </p>
    )
  }
</Dashboard>
