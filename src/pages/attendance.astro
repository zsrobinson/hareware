---
import { env } from "cloudflare:workers";
import Dashboard from "~/layouts/dashboard.astro";
import { AttendanceKiosk } from "~/components/attendance-kiosk";
import { viewerState } from "~/lib/admin";
import { admitted } from "~/lib/admin-guard";
import { easternNow } from "~/lib/eastern";
import { faces } from "~/lib/faces";
import { guildMembers } from "~/lib/member";
import { kioskData } from "~/lib/members/views";

const who = admitted(Astro.locals);

Astro.response.headers.set("cache-control", "private, no-store");

/* fixed at page load so a meeting that runs past midnight stays selected */
const today = easternNow(new Date()).date;

/* the whole roster up front, so searching needs no network. Also what
   `/api/members/kiosk` answers */
const data = await kioskData(env, today, Astro.url.searchParams.get("meeting"));

/* the whole guild, for pictures and the Discord chip's autocomplete */
const guild = await guildMembers();
const rosterFaces = await faces([...guild.keys()], async () => guild);
const guildOptions = [...guild].map(([id, profile]) => ({
  id,
  username: profile.username,
  displayName: profile.displayName,
}));
---

<Dashboard title="Attendance" viewer={viewerState(who)}>
  {
    env.NOTION_TOKEN ? (
      <AttendanceKiosk
        initial={data}
        today={today}
        faces={rosterFaces}
        guild={guildOptions}
        client:load
      />
    ) : (
      <p class="text-destructive text-sm">
        NOTION_TOKEN is not set, so attendance cannot be recorded.
      </p>
    )
  }
</Dashboard>
