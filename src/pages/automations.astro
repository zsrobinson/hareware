---
import Dashboard from "~/layouts/dashboard.astro";
import { AutomationTriggers } from "~/components/automation-triggers";
import { viewerState } from "~/lib/admin";
import { admitted } from "~/lib/admin-guard";
import { AUTOMATIONS } from "~/lib/automations/registry";

/* Reaching this page is the permission: the guard already refused anybody it
   would not admit, and its lookup knows what to call them. */
const who = admitted(Astro.locals);

Astro.response.headers.set("cache-control", "private, no-store");
---

<Dashboard title="Automations" viewer={viewerState(who)}>
  <div class="max-w-3xl space-y-4">
    <p class="text-muted-foreground text-sm">
      These run on their own each morning. Firing one here takes the same path,
      so what you see is what the morning would have done, and every run is
      recorded in the log.
    </p>

    <AutomationTriggers automations={AUTOMATIONS} client:load />
  </div>
</Dashboard>
