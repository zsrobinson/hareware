---
import Dashboard from "~/layouts/dashboard.astro";
import { ChartsPage } from "~/components/archive/charts";

/* a static shell: the island asks the gated /api/archive.json for the data,
   and draws the refusal itself if the answer is no (ADR 0012) */
export const prerender = true;
---

<Dashboard title="Charts">
  <div class="space-y-6">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Charts</h1>
      <p class="text-muted-foreground text-sm">
        How the archive breaks down by time, section and person.
      </p>
    </header>

    <ChartsPage client:load />
  </div>
</Dashboard>
