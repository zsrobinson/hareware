---
import Dashboard from "~/layouts/dashboard.astro";
import { Badge } from "~/components/ui/badge";
import { viewerState } from "~/lib/admin";
import { admitted } from "~/lib/admin-guard";
import {
  buildCommands,
  type ApplicationCommand,
  type CommandOption,
} from "~/lib/services/discord/commands";

const who = admitted(Astro.locals);

Astro.response.headers.set("cache-control", "private, no-store");

/* the registered payload itself, without Notion's choices: a schema read per
   view is not worth it */
const commands = buildCommands([]);

const usage = (command: ApplicationCommand, subcommand: CommandOption) =>
  `/${command.name} ${subcommand.name}${subcommand.options
    .map(
      (option) =>
        ` ${option.required ? `<${option.name}>` : `[${option.name}]`}`,
    )
    .join("")}`;
---

<Dashboard title="Slash Commands" viewer={viewerState(who)} width="prose">
  <div class="space-y-4">
    <p class="text-muted-foreground text-sm">
      A reference for the editorial commands available in Discord. Replies are
      visible only to the person who ran the command. Required options use angle
      brackets; optional ones use square brackets.
    </p>

    {
      commands.map((command) => (
        <div class="space-y-3">
          <div class="space-y-1">
            <h2 class="font-mono text-sm font-medium">/{command.name}</h2>
            <p class="text-muted-foreground text-sm">{command.description}</p>
          </div>

          <ul class="space-y-3">
            {command.options.map((subcommand) => (
              <li class="rounded-lg border p-4">
                <code class="text-sm font-medium">
                  {usage(command, subcommand)}
                </code>

                <p class="text-muted-foreground mt-1 text-sm">
                  {subcommand.description}
                </p>

                {subcommand.options.length === 0 ? (
                  <p class="text-muted-foreground mt-3 text-sm">
                    Takes no options.
                  </p>
                ) : (
                  <ul class="mt-3 space-y-2">
                    {subcommand.options.map((option) => (
                      <li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm">
                        <span class="font-mono">{option.name}</span>

                        {option.required ? (
                          <Badge variant="secondary">required</Badge>
                        ) : (
                          <Badge variant="outline">optional</Badge>
                        )}

                        {option.autocomplete && (
                          <Badge variant="outline">autocompleted</Badge>
                        )}

                        {option.choices && (
                          <Badge variant="outline">Notion choices</Badge>
                        )}

                        <span class="text-muted-foreground min-w-0">
                          {option.description}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Dashboard>
