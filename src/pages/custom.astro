---
import SlideFonts from "~/components/slide-fonts.astro";
import Dashboard from "~/layouts/dashboard.astro";
import { CustomPage } from "../components/custom-page";

/* nothing here is per-request — the whole page is one client island */
export const prerender = true;
---

<Dashboard title="Custom post" width="full">
  <SlideFonts slot="head" />

  <div class="space-y-6">
    <CustomPage client:load />
  </div>
</Dashboard>
