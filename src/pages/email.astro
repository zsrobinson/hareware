---
/*
  A static file (ADR 0012): the island reads the latest articles from WordPress
  itself, so serving this costs the Worker nothing.
*/
import { NewsletterPage } from "~/components/newsletter-page";
import Dashboard from "~/layouts/dashboard.astro";
import EarlyFetch from "~/components/early-fetch.astro";

export const prerender = true;
---

<Dashboard title="Newsletter" width="wide">
  <EarlyFetch slot="head" early={"latest"} />
  <div class="space-y-6">
    <NewsletterPage client:load />
  </div>
</Dashboard>
