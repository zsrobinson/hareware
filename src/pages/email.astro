---
import { EMAIL_IMAGE_WIDTH, toSizedImage } from "~/lib/image-url";
import { toArticleLink } from "~/lib/article-url";
import { getRecentArticles } from "~/lib/get-recent-articles";
import { mapLimit } from "~/lib/map-limit";
import { scrapeArticle } from "~/lib/scrape-article";

/* this page does render scraped titles and bylines, so the window has to stay
   short enough that a title fixed mid-build isn't served stale behind it. the
   concurrency cap below and the rendered-page fallback are what actually hold
   the rate limit off — the cache is only here to spare a repeat opening */
Astro.response.headers.set(
  "cache-control",
  "public, s-maxage=30, stale-while-revalidate=60",
);

const articles = await getRecentArticles();
if (!articles) throw Error("cannot fetch recent articles");

/* the feed decides these urls, not us — filter them through the same host
   allow-list every other entry point uses before anything fetches one */
const ours = articles.filter(({ link }) => toArticleLink(link) !== undefined);

/* three at a time rather than ten: this page is the one place that reliably
   tripped wordpress.com's rate limit on its own */
const scraped = (
  await mapLimit(ours, 3, async ({ link }) => {
    // an article pulled between the feed and the lookup shouldn't cost us the
    // other nine, same as the batch counter
    try {
      return await scrapeArticle(link);
    } catch {
      return null;
    }
  })
).filter((post) => post !== null);
---

<meta charset="utf-8" />

<div
  style="background-color: #5b2218 !important; padding: 8px 12px 8px 12px; line-height: 1.15; text-align: center;"
>
  <img
    src="https://i0.wp.com/theumdhare.com/wp-content/uploads/2026/02/combination-mark.png?h=90"
    style="height: 30px;"
  />
</div>

<p>Hey Everyone,</p>

<div
  style="background-color: rgb(244, 204, 204); padding: 8px 12px 8px 12px; line-height: 1.15;"
>
  <b
    ><font size="4"
      >Our next general body meeting will be [DATE] at [TIME] in [LOCATION].</font
    ></b
  >
</div>

<p>[EMAIL BODY]</p>

<br />
<br />

<hr />
<b><font size="4">Latest Articles</font></b>
<br />
<br />

<table>
  {
    scraped?.map((post) => (
      <tr>
        <td style="vertical-align: top; padding: 0 0 12px 0;">
          <img
            src={toSizedImage(post.image, EMAIL_IMAGE_WIDTH)}
            style="width: 150px"
          />
        </td>
        <td style="vertical-align: top; padding: 0 0 12px 12px;">
          <strong>
            <a href={post.link} set:html={post.title} />
          </strong>
          <br />
          Article by {post.author}
          <br />
          Image by {post.imageCredits}
        </td>
      </tr>
    ))
  }
</table>
