---
/*
  A static file (ADR 0012): the island reads the latest articles from WordPress
  itself, so serving this costs the Worker nothing.
*/
import { NewsletterPage } from "~/components/newsletter-page";
import PageHeader from "~/components/page-header.astro";
import Dashboard from "~/layouts/dashboard.astro";

export const prerender = true;
---

<Dashboard title="Newsletter" width="wide">
  <div class="space-y-6">
    <PageHeader
      title="Newsletter"
      description="This week's club email, with the latest articles, to paste into Gmail."
    />
    <NewsletterPage client:load />
  </div>
</Dashboard>
