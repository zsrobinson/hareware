---
import Dashboard from "~/layouts/dashboard.astro";
import PageHeader from "~/components/page-header.astro";
import { NewsletterPage } from "~/components/newsletter-page";
import {
  EMAIL_IMAGE_WIDTH,
  toSizedImage,
} from "~/lib/services/wordpress/image-url";
import { toArticleLink } from "~/lib/services/wordpress/article-url";
import { getRecentArticles } from "~/lib/services/wordpress/get-recent-articles";
import { mapLimit } from "~/lib/map-limit";
import { scrapeArticle } from "~/lib/services/wordpress/scrape-article";

/* short, so a title fixed mid-build is not served stale */
Astro.response.headers.set(
  "cache-control",
  "public, s-maxage=30, stale-while-revalidate=60",
);

const articles = await getRecentArticles();

/* the feed's urls go through the host allow-list before anything fetches them */
const ours = (articles ?? []).filter(
  ({ link }) => toArticleLink(link) !== undefined,
);

/* more at once trips wordpress.com's rate limit */
const scraped = (
  await mapLimit(ours, 3, async ({ link }) => {
    try {
      return await scrapeArticle(link);
    } catch {
      return null;
    }
  })
).filter((post) => post !== null);

const newsletter = scraped.map((post) => ({
  title: post.title,
  link: post.link,
  image: toSizedImage(post.image, EMAIL_IMAGE_WIDTH),
  author: post.author ?? undefined,
  imageCredits: post.imageCredits ?? undefined,
}));
---

<Dashboard title="Newsletter" width="wide">
  <div class="space-y-6">
    <PageHeader
      title="Newsletter"
      description="This week's club email, with the latest articles, to paste into Gmail."
    />
    {
      articles ? (
        <NewsletterPage articles={newsletter} client:load />
      ) : (
        <p class="text-muted-foreground text-sm">
          The latest articles couldn't be read just now. Try again in a minute.
        </p>
      )
    }
  </div>
</Dashboard>
