---
import { GeneratePage } from "~/components/generate-page";
import Root from "../layouts/root.astro";
import { toArticleLink, toArticleSlug } from "../lib/article-url";
import { SLIDE_IMAGE_WIDTH, toSizedImage } from "../lib/image-url";
import { scrapeArticle } from "../lib/scrape-article";

const param = Astro.url.searchParams.get("article") || "";

/* check that we have a good article */
const link = toArticleLink(param);
if (!link) return Astro.redirect("/?error");

/* tidy up the url when someone hands us a full permalink */
const slug = toArticleSlug(link);
if (param !== slug) return Astro.redirect(`/generate?article=${slug}`);

/* the article is read live so a title fixed mid-post shows up on the next
   reload — say so out loud rather than leaving it to a cdn default */
Astro.response.headers.set("cache-control", "private, no-store");

let post;
try {
  post = await scrapeArticle(link);
} catch (e) {
  return Astro.redirect("/?error");
}

const { title, author, image, imageCredits, content } = post;
---

<Root preloadSlideFonts>
  <GeneratePage
    defaultTitle={title}
    defaultArticleByline={author ?? ""}
    defaultImageByline={imageCredits ?? ""}
    articleLink={link}
    imageURI={toSizedImage(image, SLIDE_IMAGE_WIDTH)}
    client:load
  >
    <!-- must render here, cannot pass Element[] as prop since it gets serialized -->
    {
      author
        ? content.slice(1).map((para) => <Fragment set:html={para.outerHTML} />)
        : content.map((para) => <Fragment set:html={para.outerHTML} />)
    }
  </GeneratePage>
</Root>
