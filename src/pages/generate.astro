---
/*
  A static file (ADR 0012): the island reads `?article=` and `?page=` and asks
  WordPress itself, so serving this costs the Worker nothing.
*/
import { InstagramPosts } from "~/components/instagram-posts";
import SlideFonts from "~/components/slide-fonts.astro";
import Dashboard from "~/layouts/dashboard.astro";
import EarlyFetch from "~/components/early-fetch.astro";

export const prerender = true;
---

<Dashboard title="Instagram Posts" width="full">
  <EarlyFetch slot="head" early={"article-or-recent"} />
  <SlideFonts slot="head" />
  <InstagramPosts client:only="react" />
</Dashboard>

<script>
  import { pageScroller } from "~/lib/page-scroll";

  /* paging through the list scrolls back to the top otherwise, which loses the
     place you were reading from. the listeners live on document, so they
     survive the swaps and only need registering once */
  let keepScroll: number | null = null;

  document.addEventListener("astro:before-preparation", (event) => {
    const source = (event as any).sourceElement as Element | undefined;
    keepScroll = source?.closest("[data-keep-scroll]")
      ? pageScroller().element.scrollTop
      : null;
  });

  /* after the router has scrolled the new page to its top. The list is drawn
     after the swap, so the page is too short to hold the place until it has
     drawn: try each frame until it does, for a couple of seconds at most */
  document.addEventListener("astro:after-swap", () => {
    const place = keepScroll;
    keepScroll = null;
    if (place === null) return;
    const until = performance.now() + 2000;
    const restore = () => {
      const scroller = pageScroller().element;
      scroller.scrollTop = place;
      if (scroller.scrollTop < place - 1 && performance.now() < until)
        requestAnimationFrame(restore);
    };
    restore();
  });
</script>
