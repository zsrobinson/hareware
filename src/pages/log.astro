---
import { env } from "cloudflare:workers";
import Dashboard from "~/layouts/dashboard.astro";
import { InvocationLog } from "~/components/invocation-log";
import { viewerState } from "~/lib/admin";
import { admitted } from "~/lib/admin-guard";
import { recent } from "~/lib/log";

/* Reaching this page is the permission: the guard already refused anybody it
   would not admit, and its lookup knows what to call them. */
const who = admitted(Astro.locals);

/* the log names who pressed what, so no cache may hold any part of this —
   ADR 0005 for the rule, ADR 0007 for why this page is the sensitive one */
Astro.response.headers.set("cache-control", "private, no-store");

const rows = env.DB ? await recent(env.DB, 500) : [];
---

<Dashboard title="Invocation Log" viewer={viewerState(who)}>
  <div class="space-y-4">
    <p class="text-muted-foreground text-sm">
      Everything HareWare has done. A quiet morning shows a row saying nothing
      published, which is how it is told apart from a broken one.
    </p>

    <InvocationLog rows={rows} client:load />
  </div>
</Dashboard>
