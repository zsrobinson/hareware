---
/*
  A static file (ADR 0012): the island reads `?article=` and asks WordPress
  itself, so serving this costs the Worker nothing.
*/
import { InDesignExport } from "~/components/indesign-export";
import Dashboard from "~/layouts/dashboard.astro";
import EarlyFetch from "~/components/early-fetch.astro";

export const prerender = true;
---

<Dashboard title="InDesign Export" width="form">
  <EarlyFetch slot="head" early={"article"} />
  <div class="space-y-6">
    <InDesignExport client:only="react" />
  </div>
</Dashboard>
