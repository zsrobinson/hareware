---
import { ChevronRightIcon, DownloadIcon } from "lucide-react";
import { Button } from "~/components/ui/button";
import { Input } from "~/components/ui/input";
import Field from "~/components/copy-field.astro";
import PageHeader from "~/components/page-header.astro";
import Dashboard from "~/layouts/dashboard.astro";
import { viewer, viewerState } from "~/lib/admin";
import {
  toArticleLink,
  toArticleSlug,
} from "~/lib/services/wordpress/article-url";
import {
  PREVIEW_IMAGE_WIDTH,
  toSizedImage,
} from "~/lib/services/wordpress/image-url";
import { scrapeArticle } from "~/lib/services/wordpress/scrape-article";
import { getTaggedText } from "../lib/get-tagged-text";

const param = Astro.url.searchParams.get("article") || "";
const invalid = Astro.url.searchParams.get("error") !== null;
const typed = Astro.url.searchParams.get("link") ?? "";

Astro.response.headers.set("cache-control", "private, no-store");

let link: string | undefined;
let post: Awaited<ReturnType<typeof scrapeArticle>> | null = null;

if (param) {
  link = toArticleLink(param);
  /* the typed link comes back with the error, so it can be fixed in place */
  if (!link)
    return Astro.redirect(`/magazine?error&link=${encodeURIComponent(param)}`);

  const slug = toArticleSlug(link);
  if (param !== slug) return Astro.redirect(`/magazine?article=${slug}`);

  try {
    post = await scrapeArticle(link);
  } catch {
    return Astro.redirect(`/magazine?error&link=${encodeURIComponent(param)}`);
  }
}

const { title, author, image, imageCredits, section, date, body } = post ?? {};
const { output, unprocessed } = body
  ? getTaggedText(body)
  : { output: "", unprocessed: new Set<string>() };
const who = viewerState(await viewer(Astro.request));
---

<Dashboard title="InDesign Export" viewer={who} width="form">
  <div class="space-y-6">
    <PageHeader
      title="InDesign Export"
      description="An article's title, bylines, image and text, ready for the print issue."
    />

    <form action="/magazine" class="flex gap-2">
      <Input
        type="text"
        name="article"
        placeholder="Paste an article link"
        aria-label="Article link"
        defaultValue={link ?? typed}
        aria-invalid={invalid || undefined}
      />
      <Button type="submit" variant={post ? "secondary" : "default"}>
        Export
        <ChevronRightIcon />
      </Button>
    </form>

    {
      invalid && (
        <p class="text-destructive -mt-4 text-sm">
          That isn't a link to a Hare article. It should start with
          theumdhare.com.
        </p>
      )
    }

    {
      post && (
        <div class="space-y-4">
          <Field label="Title" id="title" value={title ?? ""} />
          <Field
            label="Article byline"
            id="article-by"
            value={[
              section?.toUpperCase(),
              author ? `Article by ${author}\t${date}` : date,
            ]
              .filter(Boolean)
              .join(" | ")}
          />
          <Field
            label="Image byline"
            id="image-by"
            value={imageCredits ? `Image by ${imageCredits}` : ""}
            empty="No image credit on the article"
          />

          <div class="space-y-1.5">
            <div class="flex items-baseline justify-between gap-4">
              <span class="text-sm font-medium">Image</span>
              {image && (
                <a
                  href={image}
                  target="_blank"
                  rel="noreferrer"
                  class="text-muted-foreground hover:text-foreground text-sm underline-offset-4 hover:underline"
                >
                  Open full size
                </a>
              )}
            </div>
            {image ? (
              <img
                src={toSizedImage(image, PREVIEW_IMAGE_WIDTH)}
                alt=""
                class="bg-secondary w-full rounded-md object-contain"
              />
            ) : (
              <p class="text-muted-foreground text-sm">No featured image.</p>
            )}
          </div>

          <div class="space-y-1.5">
            <span class="text-sm font-medium">Text</span>
            <Button id="button" variant="outline" className="w-full">
              <DownloadIcon />
              Download text for InDesign
            </Button>
            <p class="text-muted-foreground text-sm">
              In InDesign, use File → Place with this file, then check the
              result against the article.
            </p>
            {unprocessed.size > 0 && (
              <p class="text-muted-foreground text-sm">
                Some formatting won't carry over (
                {[...unprocessed].map((tag) => tag.toLowerCase()).join(", ")}
                ); check those parts by hand.
              </p>
            )}
          </div>
        </div>
      )
    }
  </div>

  <script define:vars={{ output, title }} is:inline>
    window.vars = { output, title };
  </script>

  <script>
    import download from "downloadjs";
    import { slugify } from "~/lib/utils";

    // module scripts only evaluate once, so with view transitions in play the
    // binding has to be redone every time we land on this page
    document.addEventListener("astro:page-load", () => {
      const button = document.getElementById("button");
      if (!button) return; // navigated somewhere that isn't the exporter

      const { output, title } = (window as any).vars;
      button.addEventListener("click", () => {
        download(output, slugify(title) + ".txt", "text/plain");
      });
    });
  </script>
</Dashboard>
