---
import Dashboard from "~/layouts/dashboard.astro";
import EarlyFetch from "~/components/early-fetch.astro";
import { PeoplePage } from "~/components/archive/people";

/* a static shell: the island asks the gated /api/archive.json for the data,
   and draws the refusal itself if the answer is no (ADR 0012) */
export const prerender = true;
---

<Dashboard title="People">
  <EarlyFetch early={{ api: "/api/archive.json" }} />
  <div class="space-y-6">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">People</h1>
      <p class="text-muted-foreground text-sm">
        Everyone credited on a published article.
      </p>
    </header>

    <PeoplePage client:load />
  </div>
</Dashboard>
