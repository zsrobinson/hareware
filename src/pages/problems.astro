---
import Dashboard from "~/layouts/dashboard.astro";
import { ProblemsPage } from "~/components/archive/problems";
import { viewerState } from "~/lib/admin";
import { admitted } from "~/lib/admin-guard";

const who = admitted(Astro.locals);

/* real names from the Sheet reach this page's data, so nothing may cache it */
Astro.response.headers.set("cache-control", "private, no-store");
---

<Dashboard title="Problems" viewer={viewerState(who)}>
  <div class="space-y-6">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Problems</h1>
      <p class="text-muted-foreground text-sm">
        Posts whose credits HareWare could not read, and how to fix each one in
        WordPress or the Sheet.
      </p>
    </header>

    <ProblemsPage client:load />
  </div>
</Dashboard>
