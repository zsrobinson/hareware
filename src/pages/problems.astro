---
import Dashboard from "~/layouts/dashboard.astro";
import EarlyFetch from "~/components/early-fetch.astro";
import { ProblemsPage } from "~/components/archive/problems";

/* a static shell: the island asks the gated /api/archive.json for the data,
   and draws the refusal itself if the answer is no (ADR 0012) */
export const prerender = true;
---

<Dashboard title="Problems">
  <EarlyFetch slot="head" early={{ api: "/api/archive.json" }} />
  <div class="space-y-6">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Problems</h1>
      <p class="text-muted-foreground text-sm">
        Articles with missing or unreadable credits, and names that might be one
        person.
      </p>
    </header>

    <ProblemsPage client:load />
  </div>
</Dashboard>
