---
/*
  A random published article. A static file (ADR 0012): the script below asks
  WordPress for one and goes there, so serving this costs the Worker nothing.
*/
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>HareWare: a random article</title>
  </head>
  <body>
    <p>Finding a random article…</p>
    <script>
      import { getRandomArticle } from "~/lib/services/wordpress/get-random-article";

      /* no article to pick is not a bad link: fall back to the plain landing */
      void getRandomArticle().then((link) =>
        window.location.replace(link ?? "/generate"),
      );
    </script>
  </body>
</html>
