---
import Dashboard from "~/layouts/dashboard.astro";
import EarlyFetch from "~/components/early-fetch.astro";
import { SettingsPage } from "~/components/archive/settings";

/* a static shell: the island asks the gated /api/archive.json for the data,
   and draws the refusal itself if the answer is no (ADR 0012) */
export const prerender = true;
---

<Dashboard title="Settings">
  <EarlyFetch early={{ api: "/api/archive.json" }} />
  <div class="space-y-6">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Settings</h1>
      <p class="text-muted-foreground text-sm">
        Pen names, credit labels and the Sheet.
      </p>
    </header>

    <SettingsPage client:load />
  </div>
</Dashboard>
