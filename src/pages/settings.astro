---
import Dashboard from "~/layouts/dashboard.astro";
import { SettingsPage } from "~/components/archive/settings";
import { viewerState } from "~/lib/admin";
import { admitted } from "~/lib/admin-guard";

const who = admitted(Astro.locals);

/* real names from the Sheet reach this page's data, so nothing may cache it */
Astro.response.headers.set("cache-control", "private, no-store");
---

<Dashboard title="Settings" viewer={viewerState(who)}>
  <div class="space-y-6">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold tracking-tight">Settings</h1>
      <p class="text-muted-foreground text-sm">
        Pen names, credit labels and the Sheet.
      </p>
    </header>

    <SettingsPage client:load />
  </div>
</Dashboard>
