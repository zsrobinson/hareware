---
/*
  where the oauth callback sends somebody when it could not finish, and where
  "use a different account" lands after signing out.

  the sidebar's own button is what a member normally signs in with — this page
  exists for the cases that need a sentence explaining themselves
*/
import Dashboard from "~/layouts/dashboard.astro";
import Message from "~/components/message.astro";
import { getAuthConfig } from "~/lib/auth-config";
import { viewer, viewerState } from "~/lib/admin";

Astro.response.headers.set("cache-control", "private, no-store");

const config = getAuthConfig();
const who = viewerState(await viewer(Astro.request));
const returnTo = Astro.url.searchParams.get("returnTo") ?? "/generate";

const errorMessages: Record<string, string> = {
  cancelled: "Sign-in was cancelled. Nothing changed.",
  invalid_state: "That sign-in attempt expired. Try again.",
  discord: "Discord sign-in failed. Try again.",
  not_configured: import.meta.env.DEV
    ? "Discord sign-in is not configured. Follow the README setup checklist."
    : "Sign-in is temporarily unavailable.",
};

const errorCode = Astro.url.searchParams.get("error") ?? "";
const error = !config
  ? errorMessages.not_configured
  : (errorMessages[errorCode] ?? null);

/*
  already signed in and nothing went wrong: there is nothing to do here, so
  send them where they were going rather than showing them a page whose only
  content is that they are already signed in
*/
if (who.session && !error) return Astro.redirect(returnTo);

const title = who.session ? "Signed in" : "Sign in to HareWare";

/* without config there is nothing behind the button, so it is not offered */
const action = config
  ? {
      label: who.session ? "Sign in again" : "Sign in with Discord",
      href: `/auth/discord?${new URLSearchParams({ returnTo })}`,
    }
  : undefined;
---

<Dashboard title="Sign in" viewer={who}>
  <Message title={title} action={action}>
    {
      error ??
        "HareWare uses your Discord account to know who you are, and asks for nothing else."
    }
  </Message>
</Dashboard>
