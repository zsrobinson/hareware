---
import { env } from "cloudflare:workers";
import Dashboard from "~/layouts/dashboard.astro";
import { StandingTable } from "~/components/standing-table";
import { viewerState } from "~/lib/admin";
import { admitted } from "~/lib/admin-guard";
import { easternNow } from "~/lib/eastern";
import { corpus, type Corpus } from "~/lib/members/roster";
import { readStatuses } from "~/lib/members/views";
import { ALUM_STATUS } from "~/lib/members/config";
import { AlumMissing, Problem } from "~/components/problem";
import { faces } from "~/lib/faces";

const who = admitted(Astro.locals);

Astro.response.headers.set("cache-control", "private, no-store");

/* read once; the island recomputes `standings()` locally on every change */
const token = env.NOTION_TOKEN;
const rows: Corpus | null = token ? await corpus(token) : null;

const rosterFaces = await faces(
  (rows?.people ?? []).map((person) => person.discordId),
);

const statuses = await readStatuses(token);

/* eastern, like the notion dates the window is compared against */
const today = easternNow(new Date()).date;
---

<Dashboard title="Standing" viewer={viewerState(who)}>
  <div class="space-y-4">
    {
      token && statuses.problem && (
        <Problem>
          Nothing here confirms that "{ALUM_STATUS}" is still the option alumni
          are excluded on. {statuses.problem}
        </Problem>
      )
    }
    {statuses.alumMissing && <AlumMissing options={statuses.live} />}

    {
      rows ? (
        <StandingTable
          corpus={rows}
          today={today}
          faces={rosterFaces}
          client:load
        />
      ) : (
        <p class="text-destructive text-sm">
          NOTION_TOKEN is not set, so there is nothing to count.
        </p>
      )
    }
  </div>
</Dashboard>
