---
import { Textarea } from "~/components/ui/textarea";
import { Button } from "~/components/ui/button";
import Dashboard from "~/layouts/dashboard.astro";
import { viewer, viewerState } from "~/lib/admin";
import PageHeader from "~/components/page-header.astro";
import { toArticleLink } from "~/lib/services/wordpress/article-url";
import { getWordCount } from "~/lib/get-word-count";
import { scrapeArticle } from "~/lib/services/wordpress/scrape-article";
import { mapLimit } from "~/lib/map-limit";

function redirectError(error: string) {
  const params = Astro.url.searchParams;
  params.set("error", error);
  return Astro.redirect("/words?" + params);
}

const error = Astro.url.searchParams.get("error");
const ERRORS: Record<string, string> = {
  "too-many": "Ten links at most.",
  "too-few": "Paste at least one article link.",
};

const articlesStr = Astro.url.searchParams.get("articles");
/* one row per link, in the order pasted; a link that could not be read keeps
   its row so the rest still line up */
type Row = {
  link: string;
  title: string | null;
  words: number | null;
  /** pasted text that is not a Hare link, kept as typed */
  foreign?: boolean;
};
let counts: Row[] = [];
if (articlesStr && !error) {
  /* CRLF or LF: `URL` strips newlines, so an unsplit blob would parse as one
     link */
  const articles = articlesStr
    .split(/\r?\n/)
    .map((a) => a.trim())
    .filter((a) => a !== "");

  if (articles.length > 10) return redirectError("too-many");
  if (articles.length < 1) return redirectError("too-few");

  /* ten at once draws 429s */
  counts = await mapLimit(articles, 3, async (pasted): Promise<Row> => {
    const link = toArticleLink(pasted);
    if (!link) return { link: pasted, title: null, words: null, foreign: true };
    try {
      const { body, title } = await scrapeArticle(link);
      return { link, title, words: getWordCount(body) };
    } catch {
      return { link, title: null, words: null };
    }
  });
}
Astro.response.headers.set("cache-control", "private, no-store");

const who = viewerState(await viewer(Astro.request));
---

<Dashboard title="Word Counter" viewer={who} width="form">
  <div class="space-y-6">
    <PageHeader
      title="Word Counter"
      description="How long each article is, for planning the print issue."
    />

    <form action="/words" class="space-y-2">
      <Textarea
        name="articles"
        aria-label="Article links"
        className="h-40"
        defaultValue={articlesStr ?? ""}
        placeholder="Paste up to ten article links, one per line"
        aria-invalid={error ? true : undefined}
      />
      {
        error && (
          <p class="text-destructive text-sm">
            {ERRORS[error] ?? "Those links couldn't be read."}
          </p>
        )
      }
      <Button type="submit" id="count">Count words</Button>
    </form>

    {
      counts.length > 0 && (
        <div class="overflow-hidden rounded-xl border">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-muted-foreground bg-muted/40 border-b text-left">
                <th class="px-4 py-2 font-medium">Article</th>
                <th class="px-4 py-2 text-right font-medium">Words</th>
              </tr>
            </thead>
            <tbody class="divide-y">
              {counts.map((row) => (
                <tr>
                  <td class="px-4 py-2 break-all">
                    {row.foreign ? (
                      <span class="text-muted-foreground">{row.link}</span>
                    ) : (
                      <a
                        href={row.link}
                        target="_blank"
                        rel="noreferrer"
                        class="decoration-muted-foreground/40 hover:decoration-foreground break-normal underline underline-offset-4"
                        set:html={row.title ?? row.link}
                      />
                    )}
                  </td>
                  <td class="text-muted-foreground px-4 py-2 text-right whitespace-nowrap tabular-nums">
                    {row.foreign ? (
                      "Not a Hare link"
                    ) : row.words === null ? (
                      "Couldn't read it"
                    ) : (
                      <span class="text-foreground">
                        {row.words.toLocaleString("en-US")}
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
            {counts.length > 1 && (
              <tfoot>
                <tr class="border-t font-medium">
                  <td class="px-4 py-2">Total</td>
                  <td class="px-4 py-2 text-right tabular-nums">
                    {counts
                      .reduce((sum, row) => sum + (row.words ?? 0), 0)
                      .toLocaleString("en-US")}
                  </td>
                </tr>
              </tfoot>
            )}
          </table>
        </div>
      )
    }
  </div>
</Dashboard>

<script>
  /* reading ten articles takes a moment; say so rather than look stuck */
  document.addEventListener("astro:page-load", () => {
    const button = document.getElementById("count") as HTMLButtonElement;
    button?.form?.addEventListener("submit", () => {
      button.disabled = true;
      button.textContent = "Counting…";
    });
  });
</script>
