---
import { Textarea } from "~/components/ui/textarea";
import { Button } from "~/components/ui/button";
import Dashboard from "~/layouts/dashboard.astro";
import { viewer, viewerState } from "~/lib/admin";
import PageHeader from "~/components/page-header.astro";
import { toArticleLink } from "~/lib/services/wordpress/article-url";
import { getWordCount } from "~/lib/get-word-count";
import { scrapeArticle } from "~/lib/services/wordpress/scrape-article";
import { mapLimit } from "~/lib/map-limit";

function redirectError(error: string) {
  const params = Astro.url.searchParams;
  params.set("error", error);
  return Astro.redirect("/words?" + params);
}

const error = Astro.url.searchParams.get("error");
const ERRORS: Record<string, string> = {
  "too-many": "Ten links at most.",
  "too-few": "Paste at least one article link.",
};

const articlesStr = Astro.url.searchParams.get("articles");
/* one row per link, in the order pasted; a link that could not be read keeps
   its row so the rest still line up */
type Row = {
  link: string;
  title: string | null;
  words: number | null;
  /** pasted text that is not a Hare link, kept as typed */
  foreign?: boolean;
  /** an empty line in the pasted column, kept so the rows still line up */
  blank?: boolean;
};
let counts: Row[] = [];
if (articlesStr && !error) {
  /* CRLF or LF: `URL` strips newlines, so an unsplit blob would parse as one
     link */
  /* a column pasted from the page-order sheet may have gaps; they stay as
     rows, so the counts paste back beside the right links */
  const lines = articlesStr.split(/\r?\n/).map((a) => a.trim());
  /* trailing blanks are the end of the paste; leading ones are rows of the
     sheet, and dropping them would move every count up a row */
  while (lines.at(-1) === "") lines.pop();
  const articles = lines.filter((a) => a !== "");

  if (articles.length > 10) return redirectError("too-many");
  if (articles.length < 1) return redirectError("too-few");

  /* ten at once draws 429s */
  counts = await mapLimit(lines, 3, async (pasted): Promise<Row> => {
    if (pasted === "")
      return { link: "", title: null, words: null, blank: true };
    const link = toArticleLink(pasted);
    if (!link) return { link: pasted, title: null, words: null, foreign: true };
    try {
      const { body, title } = await scrapeArticle(link);
      return { link, title, words: getWordCount(body) };
    } catch {
      return { link, title: null, words: null };
    }
  });
}
/* the rows that are links, which is what the total speaks for */
const listed = counts.filter((row) => !row.blank);
/* one count per line, in the pasted order, to paste beside the links; a link
   that couldn't be counted leaves its cell empty */
const column = counts.map((row) => row.words ?? "").join("\n");

Astro.response.headers.set("cache-control", "private, no-store");

const who = viewerState(await viewer(Astro.request));
---

<Dashboard title="Word Counter" viewer={who} width="form">
  <div class="space-y-6">
    <PageHeader
      title="Word Counter"
      description="How long each article is, for planning the print issue."
    />

    <form action="/words" class="space-y-2">
      <Textarea
        name="articles"
        aria-label="Article links"
        className="h-40"
        defaultValue={articlesStr ?? ""}
        placeholder="Paste up to ten article links, one per line"
        aria-invalid={error ? true : undefined}
      />
      {
        error && (
          <p class="text-destructive text-sm">
            {ERRORS[error] ?? "Those links couldn't be read."}
          </p>
        )
      }
      <Button type="submit" id="count">Count words</Button>
    </form>

    {
      counts.length > 0 && (
        <div class="space-y-2">
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-medium">Word counts</span>
            <Button
              id="copy-counts"
              data-copy={column}
              variant="outline"
              size="sm"
            >
              Copy word counts
            </Button>
          </div>
          <div class="overflow-hidden rounded-xl border">
            <table id="counts" class="w-full text-sm">
              <thead>
                <tr class="text-muted-foreground bg-muted/40 border-b text-left">
                  <th class="px-4 py-2 font-medium">Article</th>
                  <th class="px-4 py-2 text-right font-medium">Words</th>
                </tr>
              </thead>
              <tbody class="divide-y">
                {counts.map((row) => (
                  <tr data-words={row.words ?? ""}>
                    {/* only the numbers select, so dragging down the column
                      copies one count per line, as a sheet's column pastes */}
                    <td class="px-4 py-2 break-all select-none">
                      {row.blank ? (
                        <span class="text-muted-foreground">Blank line</span>
                      ) : row.foreign ? (
                        <span class="text-muted-foreground">{row.link}</span>
                      ) : (
                        <a
                          href={row.link}
                          target="_blank"
                          rel="noreferrer"
                          class="decoration-muted-foreground/40 hover:decoration-foreground break-normal underline underline-offset-4"
                          set:html={row.title ?? row.link}
                        />
                      )}
                    </td>
                    <td class="text-muted-foreground px-4 py-2 text-right whitespace-nowrap tabular-nums">
                      {row.blank ? null : row.foreign ? (
                        <span class="select-none">Not a Hare link</span>
                      ) : row.words === null ? (
                        <span class="select-none">Couldn't read it</span>
                      ) : (
                        <span class="text-foreground">
                          {row.words.toLocaleString("en-US")}
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
              {listed.length > 1 && (
                <tfoot class="select-none">
                  <tr class="border-t font-medium">
                    <td class="px-4 py-2">
                      Total
                      {listed.some((row) => row.words === null) && (
                        <span class="text-muted-foreground font-normal">
                          {" "}
                          ({
                            listed.filter((row) => row.words !== null).length
                          }{" "}
                          of {listed.length} counted)
                        </span>
                      )}
                    </td>
                    <td class="px-4 py-2 text-right tabular-nums">
                      {counts
                        .reduce((sum, row) => sum + (row.words ?? 0), 0)
                        .toLocaleString("en-US")}
                    </td>
                  </tr>
                </tfoot>
              )}
            </table>
          </div>
          <p class="text-muted-foreground text-sm">
            One per line, in the order pasted, to paste into the next column.
          </p>
        </div>
      )
    }
  </div>
</Dashboard>

<script>
  /* reading ten articles takes a moment; say so rather than look stuck */
  document.addEventListener("astro:page-load", () => {
    /* a dragged selection down the Words column copies those rows' counts
       one per line, gaps included: the browser would drop the empty rows,
       and the counts would no longer line up with their links */
    const table = document.getElementById("counts");
    table?.addEventListener("copy", (event) => {
      const selection = getSelection();
      if (!selection || selection.isCollapsed || !event.clipboardData) return;
      const rows = [...table.querySelectorAll<HTMLElement>("tbody tr")].filter(
        (row) => selection.containsNode(row, true),
      );
      if (rows.length === 0) return;
      event.clipboardData.setData(
        "text/plain",
        rows.map((row) => row.dataset.words ?? "").join("\n"),
      );
      event.preventDefault();
    });

    const copy = document.getElementById("copy-counts");
    copy?.addEventListener("click", () => {
      navigator.clipboard
        .writeText(copy.dataset.copy ?? "")
        .then(() => (copy.textContent = "Copied"))
        .catch((error: unknown) => {
          console.error("could not copy the counts", error);
          copy.textContent = "Couldn't copy";
        })
        /* a failure needs longer to read than a tick */
        .finally(() =>
          setTimeout(
            () => (copy.textContent = "Copy word counts"),
            copy.textContent === "Copied" ? 1500 : 4000,
          ),
        );
    });

    const button = document.getElementById("count") as HTMLButtonElement;
    button?.form?.addEventListener("submit", () => {
      button.disabled = true;
      button.textContent = "Counting…";
    });
  });
</script>
