---
import { Textarea } from "~/components/ui/textarea";
import { Button } from "~/components/ui/button";
import Root from "~/layouts/root.astro";
import {
  ChevronRightIcon,
  TriangleAlertIcon,
  Link2Icon,
  QuoteIcon,
} from "lucide-react";
import { toArticleLink } from "~/lib/article-url";
import { getWordCount } from "~/lib/get-word-count";
import { scrapeArticle } from "~/lib/scrape-article";
import { mapLimit } from "~/lib/map-limit";
import { FormItem, FormLabel } from "~/components/options-form";

function redirectError(error: string) {
  const params = Astro.url.searchParams;
  params.set("error", error);
  console.log(params);
  return Astro.redirect("/words?" + params);
}

const error = Astro.url.searchParams.get("error");

const articlesStr = Astro.url.searchParams.get("articles");
let counts: (number | null)[] = [];
if (articlesStr && !error) {
  /* a textarea submits CRLF, but not every browser or paste agrees, and a
     mismatch here used to be invisible: URL strips newlines before parsing, so
     an unsplit blob came back canParse true and on theumdhare.com, then got
     sent upstream as one enormous slug */
  const articles = articlesStr
    .split(/\r?\n/)
    .map((a) => a.trim())
    .filter((a) => a !== "");

  if (articles.length > 10) return redirectError("too-many");
  if (articles.length < 1) return redirectError("too-few");

  /* takes a bare slug, a dated path or a full permalink, and rules out
     anything that isn't the hare — which is both checks this used to do
     itself, minus the newline blind spot */
  const links = articles.map(toArticleLink);
  if (links.some((link) => link === undefined))
    return redirectError("invalid-url");

  /* ten links at once is enough to start collecting 429s */
  counts = await mapLimit(links as string[], 3, async (link) => {
    // one bad slug in ten shouldn't take the whole page down with it
    try {
      const { body } = await scrapeArticle(link);
      return getWordCount(body);
    } catch {
      return null;
    }
  });
}
---

<Root title="Batch Word Counter">
  <div class="flex max-w-120 flex-col gap-2">
    <FormItem>
      <Link2Icon className="size-5 min-w-max" />
      <FormLabel>Article Links</FormLabel>
    </FormItem>

    <form action="/words" class="mb-4 flex flex-col gap-2">
      <Textarea
        name="articles"
        className="h-56 resize-none"
        defaultValue={articlesStr ?? ""}
        placeholder="Enter up to ten article links or slugs, each on its own line."
      />
      <Button variant="secondary">Count Words <ChevronRightIcon /></Button>

      {
        error && (
          <div class="ml-4 flex items-center gap-2 pt-2 text-sm font-medium text-red-500">
            <TriangleAlertIcon className="mt-0.5" />
            <span>{error}</span>
          </div>
        )
      }
    </form>

    {
      counts.length !== 0 && (
        <>
          <FormItem>
            <QuoteIcon className="size-5 min-w-max" />
            <FormLabel>Word Counts</FormLabel>
          </FormItem>

          <Textarea
            className="h-56 resize-none"
            readOnly
            value={counts.map((count) => count ?? "—").join("\n")}
          />
        </>
      )
    }
  </div>
</Root>
