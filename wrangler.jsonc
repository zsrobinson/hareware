{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hareware",
  "compatibility_date": "2026-09-02",

  // nothing of ours imports a node builtin any more, and every route answered
  // without this flag under wrangler dev (2026-11-08), but Astro's own runtime
  // still calls Buffer for base64, so dropping it could fail only in production
  "compatibility_flags": ["nodejs_compat"],

  // without this Cloudflare ignores the Worker's own cache-control headers:
  // /api/wordpress's answers are kept at the edge for a minute through it
  "cache": { "enabled": true },

  "observability": { "enabled": true },

  // the invocation log only; nothing in it is authoritative (ADR 0007)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hareware",
      "database_id": "dbbc955f-2663-4d25-8b5c-fcb1c67276d5",
    },
  ],

  // the adapter's entrypoint has no `scheduled()`; src/worker.ts adds one and
  // still answers fetch through the adapter
  "main": "./src/worker.ts",

  // hourly, since crons are UTC and src/lib/eastern.ts picks the Eastern hour.
  // `REMINDER_CRON` in src/lib/automations/run.ts must match
  "triggers": { "crons": ["0 * * * *"] },
  /*
    Only /api and /auth wake the Worker. Every page is a static file, served
    without it, and an address that is neither gets dist/404.html straight from
    the asset server, so crawlers and probes cost no CPU. ADR 0012.
  */
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/auth/*"],
  },
}
