{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hareware",
  "compatibility_date": "2026-09-02",

  // linkedom and fast-xml-parser both reach for node builtins
  "compatibility_flags": ["nodejs_compat"],

  /**
   * vercel's cdn honoured the cache-control headers the pages set on their own
   * responses; cloudflare does not cache a worker's own response unless asked.
   * this is the ask — with it, `s-maxage` on / and /email means what it did
   * before, and `private, no-store` on /generate and /magazine still opts out
   *
   * a cache hit skips the worker altogether, which is also what keeps the feed
   * pages off wordpress.com's rate limit
   */
  "cache": { "enabled": true },

  "observability": { "enabled": true },

  /**
   * the invocation log, and nothing else. per ADR 0006's rule and ADR 0007's
   * reasoning, nothing in here is authoritative: every row is derived from
   * something notion, wordpress or discord already knows, so dropping this
   * database costs the club its history and nothing more
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hareware",
      "database_id": "dbbc955f-2663-4d25-8b5c-fcb1c67276d5",
    },
  ],

  /**
   * our own entrypoint rather than the adapter's
   * `@astrojs/cloudflare/entrypoints/server`, which exports only `fetch` and so
   * gives a cron trigger nowhere to land. src/worker.ts is that file plus a
   * `scheduled()` handler; it still serves every request through the adapter's
   * own handler, which must stay the one answering fetch
   */
  "main": "./src/worker.ts",

  /**
   * two schedules, and `runScheduled` tells them apart by `controller.cron`.
   *
   * hourly is the reminders: they mean "8am eastern" and cloudflare crons are
   * utc with no timezone setting, so src/lib/eastern.ts decides whether a tick
   * is the right hour and the schedule never drifts across daylight saving.
   *
   * every minute is the article index. notion's webhooks are at-most-once and
   * unordered, so this is the only thing that guarantees the picker ever
   * matches notion — and an hour of that guarantee reads as broken to somebody
   * who just renamed a headline. two notion requests a minute against a budget
   * of three a second is nothing.
   *
   * the minute schedule must never reach the reminders. every minute of 8am
   * would otherwise be a fresh 8am, and the club would be pinged sixty times —
   * `REMINDER_CRON` in src/lib/automations/run.ts is that check, with the tests
   * that hold it
   */
  "triggers": { "crons": ["0 * * * *", "* * * * *"] },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
}
